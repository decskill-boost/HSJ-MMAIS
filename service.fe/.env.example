# URL do backend NestJS para o proxy do Vite em dev (/api -> este target)
VITE_API_TARGET=http://localhost:3000

# URL base usada pelo apiClient (axios). Em dev pode ser "/api" (passa pelo proxy do Vite).
VITE_API_URL=/api

# Credenciais do Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://o-teu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=a-tua-anon-key
