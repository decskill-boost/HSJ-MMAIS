# Modelo de configuração. Copiar para `.env.local` e preencher com os valores
# reais — o `.env.local` está no .gitignore e nunca deve ser versionado.
#
# ATENÇÃO: nenhum valor real entra neste ficheiro. Ele vai para o repositório.

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=a-tua-password-local
DB_NAME=hsjmaais

# Supabase — Project Settings > API
SUPABASE_URL=https://o-teu-projeto.supabase.co
# A service_role ignora TODAS as políticas RLS: dá leitura e escrita sobre a base
# de dados inteira, incluindo os dados clínicos das crianças. Só no servidor, só
# em .env.local, nunca no frontend e nunca aqui.
SUPABASE_SERVICE_ROLE_KEY=a-tua-service-role-key

# Google Cloud Storage — vídeos dos exercícios (ver deploy/gcs/README.md)
GCS_BUCKET=nome-do-bucket
# JSON da chave da conta de serviço, tal e qual ou em base64. Tal como a
# service_role: só no servidor, só em .env.local, nunca aqui.
GCS_CREDENTIALS=

# API
API_PREFIX=api
PORT=3000
APP_ENV=dev
