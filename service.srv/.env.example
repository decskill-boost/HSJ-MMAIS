# Porta onde o NestJS escuta
PORT=3000

# Prefixo global das rotas da API (ex.: /api/...)
API_PREFIX=api

# Ambiente da aplicação (dev | pre | prd)
APP_ENV=dev

# Origens permitidas para CORS (separadas por vírgula).
# Ex.: https://app.exemplo.pt,https://pre.app.exemplo.pt
CORS_ORIGIN=http://localhost:5173
